---
import type { Locale } from '~/i18n/config';
import { useTranslations } from '~/i18n/ui';

interface Props {
  locale: Locale;
}

const t = useTranslations(Astro.props.locale);
---

<p role="note" class="mb-6 rounded-2xl border border-line bg-tile px-4 py-3 text-sm text-muted">
  {t('common.fallback')}
</p>
