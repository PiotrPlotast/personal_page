---
import { localizePath, type Locale } from '~/i18n/config';
import { useTranslations } from '~/i18n/ui';
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  locale: Locale;
  shortName: string;
  /** Show the language switcher (hidden on pages that exist in one language only). */
  switcher?: boolean;
}

const { locale, shortName, switcher = true } = Astro.props;
const t = useTranslations(locale);
const nav = [
  { label: t('nav.projects'), href: localizePath('/projects', locale) },
  { label: t('nav.blog'), href: localizePath('/blog', locale) },
  { label: t('nav.about'), href: localizePath('/about', locale) },
  { label: t('nav.contact'), href: localizePath('/contact', locale) },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="mx-auto w-full max-w-310 px-6 pt-5 fit:pt-3">
  <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-1 rounded-[28px] border border-line bg-tile py-2 pr-2 pl-5 sm:rounded-full">
    <a
      href={localizePath('/', locale)}
      class="font-display text-[19px] font-extrabold tracking-tight no-underline hover:opacity-75"
    >
      {shortName}
    </a>
    <nav aria-label={t('nav.label')} class="order-last -ml-3 w-full sm:order-none sm:ml-0 sm:w-auto">
      <ul class="flex flex-wrap gap-0.5">
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
              class="inline-block rounded-full px-3 py-2.5 font-medium text-muted no-underline transition-colors hover:text-fg aria-[current=page]:bg-bg aria-[current=page]:text-fg sm:px-3.5"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="flex items-center gap-1.5">
      {switcher && <LanguageSwitcher locale={locale} />}
      <ThemeToggle locale={locale} />
    </div>
  </div>
</header>
