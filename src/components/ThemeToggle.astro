---
/** Toggles light/dark. The initial theme is applied by the inline script in BaseLayout. */
import type { Locale } from '~/i18n/config';
import { useTranslations } from '~/i18n/ui';

interface Props {
  locale: Locale;
}

const t = useTranslations(Astro.props.locale);
---

<button
  type="button"
  data-theme-toggle
  data-label-to-dark={t('theme.toDark')}
  data-label-to-light={t('theme.toLight')}
  aria-label={t('theme.toDark')}
  class="grid size-11 cursor-pointer place-items-center rounded-full bg-bg text-fg transition-colors hover:bg-line"
>
  <svg
    class="hidden dark:block"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
  </svg>
  <svg
    class="dark:hidden"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
</button>

<script>
  import { THEME_STORAGE_KEY, isTheme, nextTheme, themeToggleLabel, type Theme } from '~/lib/theme';

  const root = document.documentElement;
  const current = (): Theme => (isTheme(root.dataset['theme']) ? root.dataset['theme'] : 'light');

  function apply(theme: Theme) {
    root.dataset['theme'] = theme;
    for (const button of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
      const { labelToDark, labelToLight } = button.dataset;
      const labels = labelToDark && labelToLight ? { toDark: labelToDark, toLight: labelToLight } : undefined;
      button.setAttribute('aria-label', themeToggleLabel(theme, labels));
    }
  }

  apply(current());

  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
    button.addEventListener('click', () => {
      const theme = nextTheme(current());
      try {
        localStorage.setItem(THEME_STORAGE_KEY, theme);
      } catch {
        // Storage can be unavailable (private mode); the toggle still works for this page view.
      }
      apply(theme);
    });
  }

  // Follow OS changes until the visitor picks a theme themselves.
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (event) => {
    let stored: string | null = null;
    try {
      stored = localStorage.getItem(THEME_STORAGE_KEY);
    } catch {
      // ignore
    }
    if (!isTheme(stored)) apply(event.matches ? 'dark' : 'light');
  });
</script>
