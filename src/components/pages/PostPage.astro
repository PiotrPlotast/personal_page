---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import FallbackNotice from '~/components/FallbackNotice.astro';
import { localizePath, type Locale } from '~/i18n/config';
import { useTranslations } from '~/i18n/ui';
import { formatDate, isoDate, readingMinutes, slugify } from '~/lib/format';
import type { LocalizedMeta } from '~/lib/localized';

interface Props {
  locale: Locale;
  post: CollectionEntry<'posts'> & LocalizedMeta;
}

const { locale, post } = Astro.props;
const t = useTranslations(locale);
const { data } = post;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const contentLang = post.locale !== locale ? post.locale : undefined;
---

<BaseLayout
  title={data.title}
  description={data.description}
  locale={locale}
  article={{ published: data.published, updated: data.updated, tags: data.tags }}
>
  <nav aria-label="Breadcrumb" class="pt-2 pb-6">
    <a href={localizePath('/blog/', locale)} class="font-bold text-accent underline-offset-4 hover:underline">
      {t('blog.allPosts')}
    </a>
  </nav>

  {post.isFallback && <FallbackNotice locale={locale} />}

  <article lang={contentLang} data-pagefind-body class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_15rem]">
    <div class="min-w-0 rounded-tile border border-line bg-tile p-[clamp(24px,4vw,48px)]">
      <header class="mb-8">
        <p class="flex flex-wrap gap-x-3 text-sm text-muted" data-pagefind-ignore>
          <time datetime={isoDate(data.published)}>{formatDate(data.published, locale)}</time>
          <span aria-hidden="true">·</span>
          <span>{t('blog.minRead', { n: String(readingMinutes(post.body ?? '')) })}</span>
          {data.updated && (
            <>
              <span aria-hidden="true">·</span>
              <span>
                {t('blog.updated', { date: '' }).trim()}{' '}
                <time datetime={isoDate(data.updated)}>{formatDate(data.updated, locale)}</time>
              </span>
            </>
          )}
        </p>
        <h1 class="mt-3 font-display text-[clamp(36px,5.5vw,58px)] leading-[1.02] font-extrabold tracking-[-0.04em]">
          {data.title}
        </h1>
        <p class="mt-4 text-lg text-muted sm:text-xl">{data.description}</p>
        {data.tags.length > 0 && (
          <ul aria-label={t('blog.tags')} class="mt-5 flex flex-wrap gap-1.5" data-pagefind-ignore>
            {data.tags.map((tag) => (
              <li>
                <a
                  href={localizePath(`/blog/tags/${slugify(tag)}/`, locale)}
                  class="inline-flex min-h-8 items-center rounded-full bg-bg px-3 text-[13px] font-medium no-underline hover:underline"
                >
                  #{tag}
                </a>
              </li>
            ))}
          </ul>
        )}
      </header>
      <div class="prose" data-copy-label={t('blog.copy')} data-copied-label={t('blog.copied')}>
        <Content />
      </div>
    </div>

    {toc.length > 1 && (
      <aside aria-labelledby="toc-title" class="order-first lg:order-none" data-pagefind-ignore>
        <nav aria-labelledby="toc-title" class="rounded-tile border border-line bg-tile p-5 lg:sticky lg:top-6">
          <h2 id="toc-title" class="text-sm font-bold tracking-[0.06em] text-muted uppercase">
            {t('blog.toc')}
          </h2>
          <ol class="mt-3 flex flex-col gap-1.5 text-[15px]">
            {toc.map((heading) => (
              <li class:list={[heading.depth === 3 && 'pl-4']}>
                <a href={`#${heading.slug}`} class="text-muted underline-offset-4 hover:text-fg hover:underline">
                  {heading.text}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      </aside>
    )}
  </article>
</BaseLayout>

<script>
  // Copy buttons on code blocks. Always visible (not hover-only) so touch and keyboard users get them too.
  const prose = document.querySelector<HTMLElement>('.prose[data-copy-label]');
  if (prose && navigator.clipboard) {
    const label = prose.dataset['copyLabel'] ?? 'Copy code';
    const copied = prose.dataset['copiedLabel'] ?? 'Copied';
    for (const pre of prose.querySelectorAll('pre')) {
      const wrapper = document.createElement('div');
      wrapper.className = 'relative';
      pre.replaceWith(wrapper);
      wrapper.append(pre);
      pre.classList.add('pt-12');
      const button = document.createElement('button');
      button.type = 'button';
      button.textContent = label;
      button.className =
        'absolute top-2 right-2 min-h-9 cursor-pointer rounded-full border border-line bg-tile px-3 text-sm font-bold text-fg hover:border-line-strong';
      button.addEventListener('click', async () => {
        await navigator.clipboard.writeText(pre.innerText);
        button.textContent = copied;
        window.setTimeout(() => (button.textContent = label), 2000);
      });
      wrapper.append(button);
    }
  }
</script>
