---
/**
 * The contact page: a form that emails Piotr through /api/contact (see src/scripts/contact-form.ts),
 * plus the other ways to get in touch.
 */
import PageHeader from '~/components/PageHeader.astro';
import type { Locale } from '~/i18n/config';
import { localeTags } from '~/i18n/config';
import { useTranslations } from '~/i18n/ui';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { CONTACT_LIMITS, type FieldError } from '~/lib/contact/form';
import { getProfile } from '~/lib/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const profile = await getProfile(locale);

const limits = { name: CONTACT_LIMITS.name, email: CONTACT_LIMITS.email, message: CONTACT_LIMITS.messageMax };
// Interface text for the browser script; {n} and {minutes} are filled in there.
const strings = {
  errors: {
    required: t('contact.error.required'),
    email: t('contact.error.email'),
    too_short: t('contact.error.too_short'),
    too_long: t('contact.error.too_long'),
  } satisfies Record<FieldError, string>,
  limits: { ...limits, messageMin: CONTACT_LIMITS.messageMin },
  summary: t('contact.error.summary'),
  rate_limited: t('contact.error.rate_limited'),
  verify: t('contact.error.verify'),
  unavailable: t('contact.error.unavailable'),
  network: t('contact.error.network'),
  send: t('contact.send'),
  sending: t('contact.sending'),
  successTitle: t('contact.successTitle'),
  successText: t('contact.successText'),
};

const label = 'font-bold';
const field =
  'mt-2 block w-full rounded-2xl border border-line-strong bg-bg px-4 py-3 text-fg placeholder:text-muted aria-invalid:border-danger';
const hint = 'mt-1.5 text-sm text-muted';
const error = 'mt-1.5 text-sm font-medium text-danger';
const heading = 'font-display text-2xl leading-tight font-extrabold tracking-tight';
---

<BaseLayout title={t('page.contact')} description={t('contact.intro')} locale={locale}>
  <PageHeader title={t('page.contact')} intro={t('contact.intro')} />

  <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_22rem]">
    <section
      aria-labelledby="contact-form-title"
      data-contact
      data-strings={JSON.stringify(strings)}
      data-lang={localeTags[locale].lang}
      class="rounded-tile border border-line bg-tile p-6 sm:p-8"
    >
      <div data-contact-panel>
        <h2 id="contact-form-title" class={heading}>
          {t('contact.formTitle')}
        </h2>
        <p class="mt-1 text-sm text-muted">{t('contact.required')}</p>
        <noscript>
          <p class="mt-4 rounded-2xl bg-bg p-4">{t('contact.noscript')}</p>
        </noscript>

        <form data-contact-form novalidate class="mt-6 flex flex-col gap-5">
          <div>
            <label for="contact-name" class={label}>
              {t('contact.name')} <span aria-hidden="true">*</span>
            </label>
            <input
              id="contact-name"
              name="name"
              type="text"
              autocomplete="name"
              required
              maxlength={limits.name}
              aria-describedby="contact-name-error"
              class={field}
            />
            <p id="contact-name-error" data-error-for="name" class={error} hidden></p>
          </div>

          <div>
            <label for="contact-email" class={label}>
              {t('contact.email')} <span aria-hidden="true">*</span>
            </label>
            <input
              id="contact-email"
              name="email"
              type="email"
              autocomplete="email"
              inputmode="email"
              required
              maxlength={limits.email}
              aria-describedby="contact-email-hint contact-email-error"
              class={field}
            />
            <p id="contact-email-hint" class={hint}>
              {t('contact.emailHint')}
            </p>
            <p id="contact-email-error" data-error-for="email" class={error} hidden></p>
          </div>

          <div>
            <label for="contact-message" class={label}>
              {t('contact.message')} <span aria-hidden="true">*</span>
            </label>
            <textarea
              id="contact-message"
              name="message"
              rows="7"
              required
              minlength={CONTACT_LIMITS.messageMin}
              maxlength={limits.message}
              aria-describedby="contact-message-hint contact-message-error"
              class:list={[field, 'resize-y leading-relaxed']}
            ></textarea>
            <p id="contact-message-hint" class={hint}>
              {t('contact.messageHint', { n: String(CONTACT_LIMITS.messageMin) })}
            </p>
            <p id="contact-message-error" data-error-for="message" class={error} hidden></p>
          </div>

          <!-- Honeypot: invisible to people and screen readers; bots that fill every field are ignored. -->
          <div hidden>
            <label for="contact-website">{t('contact.honeypot')}</label>
            <input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>

          <div data-contact-turnstile class="empty:hidden"></div>

          <p role="alert" data-contact-error class="rounded-2xl bg-bg p-4 font-medium text-danger empty:hidden"></p>

          <div>
            <button
              type="submit"
              data-contact-submit
              class="inline-flex min-h-12 cursor-pointer items-center rounded-full bg-fg px-6 font-bold text-bg transition-opacity hover:opacity-85 disabled:cursor-wait disabled:opacity-70"
            >
              {t('contact.send')}
            </button>
          </div>
        </form>
      </div>

      <div data-contact-success hidden>
        <h2 tabindex="-1" data-contact-success-title class:list={[heading, 'focus:outline-none']}>
          {t('contact.thanks')}
        </h2>
        <p data-contact-success-text class="mt-3 text-lg text-muted"></p>
        <button
          type="button"
          data-contact-again
          class="mt-6 inline-flex min-h-12 cursor-pointer items-center rounded-full border border-line-strong px-6 font-bold transition-colors hover:bg-bg"
        >
          {t('contact.another')}
        </button>
      </div>
    </section>

    <aside
      aria-labelledby="contact-other"
      class="flex flex-col gap-4 self-start rounded-tile border border-ink-border bg-ink p-6 text-ink-fg sm:p-8"
    >
      <h2 id="contact-other" class={heading}>
        {t('contact.otherWays')}
      </h2>
      <ul class="flex flex-col gap-2">
        {profile.email && (
          <li>
            <a href={`mailto:${profile.email}`} class="font-bold underline underline-offset-4">
              {profile.email}
            </a>
          </li>
        )}
        {profile.socials.map((social) => (
          <li>
            <a href={social.href} class="font-bold underline underline-offset-4">
              {social.label}
            </a>
          </li>
        ))}
      </ul>
      <p class="text-ink-muted">{t('contact.askByte')}</p>
    </aside>
  </div>
</BaseLayout>

<script>
  import { mountContactForm } from '~/scripts/contact-form';

  const root = document.querySelector<HTMLElement>('[data-contact]');
  if (root) mountContactForm(root);
</script>
