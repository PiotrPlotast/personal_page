---
import { localizePath, type Locale } from '~/i18n/config';
import { useTranslations } from '~/i18n/ui';

interface Props {
  locale: Locale;
  page: 'projects' | 'blog' | 'about' | 'contact';
}

const { locale, page } = Astro.props;
const t = useTranslations(locale);
---

<section class="mx-auto max-w-2xl rounded-tile border border-line bg-tile p-[clamp(24px,5vw,48px)]">
  <p class="text-sm font-bold tracking-[0.06em] text-muted uppercase">{t('soon.eyebrow')}</p>
  <h1 class="mt-3 font-display text-[clamp(36px,5vw,56px)] leading-none font-extrabold tracking-[-0.04em]">
    {t(`page.${page}`)}
  </h1>
  <p class="mt-4 text-lg text-muted">{t('soon.text', { what: t(`soon.${page}`) })}</p>
  <a
    href={localizePath('/', locale)}
    class="mt-8 inline-flex min-h-12 items-center rounded-full bg-fg px-5.5 font-bold text-bg no-underline hover:opacity-85"
  >
    {t('common.backHome')}
  </a>
</section>
