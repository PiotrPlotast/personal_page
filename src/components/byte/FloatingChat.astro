---
/**
 * "Ask Byte" on every page except home: a button in the corner that opens the chat in a modal
 * dialog (full screen on phones). Same conversation as the home tile.
 */
import ChatBody from '~/components/byte/ChatBody.astro';
import type { Locale } from '~/i18n/config';
import { useTranslations } from '~/i18n/ui';
import { chatStrings } from '~/lib/byte/ui-strings';
import { getProfile } from '~/lib/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const { agent } = await getProfile(locale);
---

<button
  type="button"
  data-byte-open
  aria-haspopup="dialog"
  class="fixed right-4 bottom-4 z-40 flex min-h-12 cursor-pointer items-center gap-2.5 rounded-full border border-ink-border bg-ink py-1.5 pr-5 pl-1.5 font-bold text-ink-fg shadow-lg transition-transform hover:-translate-y-0.5 print:hidden"
>
  <span
    aria-hidden="true"
    class="grid size-9 place-items-center rounded-full bg-lime font-display text-lg font-extrabold text-on-lime"
  >
    {agent.name.charAt(0)}
  </span>
  {t('chat.title')}
</button>

<dialog
  aria-labelledby="byte-dialog-title"
  data-byte
  data-byte-dialog
  data-strings={JSON.stringify(chatStrings(locale))}
  class="byte-dialog m-0 h-dvh max-h-none w-full max-w-none flex-col overflow-hidden bg-ink text-ink-fg open:flex backdrop:bg-black/50 sm:top-auto sm:right-4 sm:bottom-4 sm:left-auto sm:h-[min(42rem,calc(100dvh-2rem))] sm:w-[26rem] sm:rounded-tile sm:border sm:border-ink-border"
>
  <div class="flex items-center gap-3 border-b border-ink-line/60 px-5 py-3">
    <span
      aria-hidden="true"
      class="grid size-10 flex-none place-items-center rounded-2xl bg-lime font-display text-lg font-extrabold text-on-lime"
    >
      {agent.name.charAt(0)}
    </span>
    <div class="min-w-0 flex-1">
      <h2 id="byte-dialog-title" class="font-display text-xl font-bold tracking-tight">
        {t('chat.title')}
      </h2>
      <p class="truncate text-sm text-ink-muted">{agent.tagline}</p>
    </div>
    <button
      type="button"
      data-byte-clear
      hidden
      aria-label={t('chat.clear')}
      class="grid size-11 flex-none cursor-pointer place-items-center rounded-full border border-ink-line transition-colors hover:bg-ink-raise"
    >
      <svg
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M3 12a9 9 0 1 0 3-6.7L3 8M3 3v5h5"></path>
      </svg>
    </button>
    <button
      type="button"
      data-byte-close
      aria-label={t('chat.close')}
      class="grid size-11 flex-none cursor-pointer place-items-center rounded-full border border-ink-line transition-colors hover:bg-ink-raise"
    >
      <svg
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M18 6 6 18M6 6l12 12"></path>
      </svg>
    </button>
  </div>
  <ChatBody locale={locale} id="byte-panel" variant="dialog" />
</dialog>

<script>
  import { mountByteChat } from '~/scripts/byte-chat';

  const opener = document.querySelector<HTMLButtonElement>('[data-byte-open]');
  const dialog = document.querySelector<HTMLDialogElement>('[data-byte-dialog]');
  const input = dialog?.querySelector<HTMLInputElement>('[data-byte-form] input');

  if (opener && dialog && input) {
    mountByteChat(dialog);

    opener.addEventListener('click', () => {
      dialog.showModal();
      input.focus();
      const log = dialog.querySelector<HTMLElement>('[data-byte-log]');
      if (log) log.scrollTop = log.scrollHeight;
    });
    dialog.querySelector('[data-byte-close]')?.addEventListener('click', () => dialog.close());
    // A click on the backdrop (the dialog element itself, outside its content) closes it too.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener('close', () => opener.focus());
  }
</script>
