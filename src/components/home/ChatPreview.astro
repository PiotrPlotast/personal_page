---
/**
 * The "Ask Byte" chat tile. Clicking the input, a suggestion, typing or the expand button grows it
 * to cover the whole bento; the close button or Esc shrinks it back. The chat itself (streaming
 * answers, history) lives in ChatBody and src/scripts/byte-chat.ts, shared with the floating chat.
 */
import ChatBody from '~/components/byte/ChatBody.astro';
import type { Locale } from '~/i18n/config';
import { useTranslations } from '~/i18n/ui';
import { chatStrings } from '~/lib/byte/ui-strings';
import { getProfile } from '~/lib/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const { agent } = await getProfile(locale);
---

<section
  aria-labelledby="chat-title"
  data-chat
  data-byte
  data-strings={JSON.stringify(chatStrings(locale))}
  class="flex flex-col gap-3.5 rounded-tile border border-ink-border bg-ink p-6 text-ink-fg sm:col-span-2 lg:row-span-2 fit:min-h-0 fit:gap-3 fit:p-5 fit-short:p-4 data-expanded:h-[calc(100dvh-9rem)] fit:data-expanded:h-auto"
>
  <div class="flex items-center gap-3">
    <span
      aria-hidden="true"
      class="grid size-11 flex-none place-items-center rounded-2xl bg-lime font-display text-xl font-extrabold text-on-lime"
    >
      {agent.name.charAt(0)}
    </span>
    <div class="min-w-0 flex-1">
      <h2 id="chat-title" class="font-display text-[22px] font-bold tracking-tight">
        {t('chat.title')}
      </h2>
      <p class="text-sm text-ink-muted">{agent.tagline}</p>
    </div>
    <span class="hidden rounded-full border border-ink-line px-3 py-1 text-xs font-bold text-ink-muted sm:inline">
      {t('chat.status')}
    </span>
    <button
      type="button"
      data-byte-clear
      hidden
      aria-label={t('chat.clear')}
      class="grid size-11 flex-none cursor-pointer place-items-center rounded-full border border-ink-line text-ink-fg transition-colors hover:bg-ink-raise"
    >
      <svg
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M3 12a9 9 0 1 0 3-6.7L3 8M3 3v5h5"></path>
      </svg>
    </button>
    <button
      type="button"
      data-chat-toggle
      aria-expanded="false"
      aria-controls="ask-byte-log"
      aria-label={t('chat.expand')}
      data-label-expand={t('chat.expand')}
      data-label-collapse={t('chat.collapse')}
      class="grid size-11 flex-none cursor-pointer place-items-center rounded-full border border-ink-line text-ink-fg transition-colors hover:bg-ink-raise"
    >
      <svg
        class="in-data-expanded:hidden"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"></path>
      </svg>
      <svg
        class="hidden in-data-expanded:block"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M18 6 6 18M6 6l12 12"></path>
      </svg>
    </button>
  </div>

  <ChatBody locale={locale} id="ask-byte" variant="tile" />
</section>

<script>
  import { insetClip } from '~/lib/clip';
  import { mountByteChat } from '~/scripts/byte-chat';

  const chat = document.querySelector<HTMLElement>('[data-chat]');
  const bento = chat?.closest<HTMLElement>('[data-bento]');
  const toggle = chat?.querySelector<HTMLButtonElement>('[data-chat-toggle]');
  const input = chat?.querySelector<HTMLInputElement>('[data-byte-form] input');

  if (chat && bento && toggle && input) {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const ease = 'cubic-bezier(0.2, 0.8, 0.2, 1)';
    const isExpanded = () => chat.hasAttribute('data-expanded');
    const otherTiles = () => [...bento.children].filter((tile): tile is HTMLElement => tile !== chat);
    const radius = () => parseFloat(getComputedStyle(chat).borderTopLeftRadius) || 0;
    let busy = false;
    let queued: boolean | undefined;

    const apply = (expanded: boolean) => {
      chat.toggleAttribute('data-expanded', expanded);
      bento.toggleAttribute('data-chat-expanded', expanded);
      toggle.setAttribute('aria-expanded', String(expanded));
      const label = expanded ? toggle.dataset['labelCollapse'] : toggle.dataset['labelExpand'];
      if (label) toggle.setAttribute('aria-label', label);
    };

    // Each step keeps handles to the animations it starts and only ever cancels those. Cancelling
    // "every animation on an element" would also kill animations a newer transition just started.
    const fade = (elements: Element[], from: number, to: number, duration: number) =>
      elements.map((el) =>
        el.animate([{ opacity: from }, { opacity: to }], { duration, easing: 'ease-out', fill: 'forwards' }),
      );
    // A cancelled animation rejects `finished`; for us that just means "done".
    const done = (animations: Animation[]) => Promise.all(animations.map((a) => a.finished.catch(() => undefined)));
    const clear = (animations: Animation[]) => animations.forEach((a) => a.cancel());
    // Fade-ins still running after a transition ends; the next transition stops them first.
    let lingering: Animation[] = [];
    const settle = (animations: Animation[]) => {
      lingering = animations;
      void done(animations).then(() => clear(animations));
    };

    // Grow: fade the other tiles out, lay the chat out at full size, then reveal it from its old
    // footprint with an expanding rounded clip so text never stretches. Shrink runs the reverse.
    const setExpanded = async (expanded: boolean): Promise<void> => {
      if (busy) {
        // Remember the latest request (e.g. Esc pressed mid-animation) and run it afterwards.
        queued = expanded;
        return;
      }
      if (isExpanded() === expanded) return;
      if (reduceMotion.matches || typeof chat.animate !== 'function') {
        apply(expanded);
        return;
      }
      busy = true;
      clear(lingering);
      try {
        if (expanded) {
          const small = chat.getBoundingClientRect();
          const fadeOut = fade(otherTiles(), 1, 0, 140);
          await done(fadeOut);
          apply(true);
          clear(fadeOut);
          const big = chat.getBoundingClientRect();
          settle(fade([...chat.children], 0, 1, 260));
          await done([
            chat.animate([{ clipPath: insetClip(small, big, radius()) }, { clipPath: insetClip(big, big, radius()) }], {
              duration: 380,
              easing: ease,
            }),
          ]);
          if (chat.getBoundingClientRect().top < 0) chat.scrollIntoView({ block: 'start' });
        } else {
          const big = chat.getBoundingClientRect();
          apply(false);
          const small = chat.getBoundingClientRect();
          apply(true);
          const shrink = chat.animate(
            [{ clipPath: insetClip(big, big, radius()) }, { clipPath: insetClip(small, big, radius()) }],
            { duration: 320, easing: ease, fill: 'forwards' },
          );
          await done([shrink]);
          apply(false);
          clear([shrink]);
          settle(fade([...chat.children, ...otherTiles()], 0, 1, 200));
        }
      } finally {
        busy = false;
      }
      if (queued !== undefined) {
        const next = queued;
        queued = undefined;
        await setExpanded(next);
      }
    };

    mountByteChat(chat, { onActivity: () => void setExpanded(true) });

    // Pointer clicks and typing expand the chat; keyboard focus alone does not (WCAG 3.2.1 On Focus).
    input.addEventListener('pointerdown', () => void setExpanded(true));
    input.addEventListener('input', () => void setExpanded(true));

    toggle.addEventListener('click', () => {
      const expand = !isExpanded();
      void setExpanded(expand);
      if (expand) input.focus();
    });

    chat.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && isExpanded()) {
        event.preventDefault();
        void setExpanded(false);
      }
    });
  }
</script>
