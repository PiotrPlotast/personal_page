---
/**
 * The "Ask Byte" chat tile. Clicking the input, a suggestion, typing or the expand button grows it
 * to cover the whole bento; the close button or Esc shrinks it back. Phase 4 swaps the placeholder reply below for the real streaming agent.
 */
import { agent } from '~/data/profile';

const reply = `I'm still in training, so I can't answer that one yet. The real me arrives soon! Until then, Piotr's projects and contact page have you covered.`;
---

<section
  aria-labelledby="chat-title"
  data-chat
  data-reply={reply}
  class="flex flex-col gap-3.5 rounded-tile border border-ink-border bg-ink p-6 text-ink-fg sm:col-span-2 lg:row-span-2 fit:gap-3 fit:p-5 fit-short:p-4 data-expanded:min-h-[calc(100dvh-9rem)] fit:data-expanded:min-h-0"
>
  <div class="flex items-center gap-3">
    <span
      aria-hidden="true"
      class="grid size-11 flex-none place-items-center rounded-2xl bg-lime font-display text-xl font-extrabold text-on-lime"
    >
      {agent.name.charAt(0)}
    </span>
    <div class="min-w-0 flex-1">
      <h2 id="chat-title" class="font-display text-[22px] font-bold tracking-tight">
        Ask {agent.name}
      </h2>
      <p class="text-sm text-ink-muted">{agent.tagline}</p>
    </div>
    <span class="hidden rounded-full border border-ink-line px-3 py-1 text-xs font-bold text-ink-muted sm:inline">
      In training
    </span>
    <button
      type="button"
      data-chat-toggle
      aria-expanded="false"
      aria-controls="chat-log"
      aria-label="Expand chat"
      class="grid size-11 flex-none cursor-pointer place-items-center rounded-full border border-ink-line text-ink-fg transition-colors hover:bg-ink-raise"
    >
      <svg
        class="in-data-expanded:hidden"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"></path>
      </svg>
      <svg
        class="hidden in-data-expanded:block"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M18 6 6 18M6 6l12 12"></path>
      </svg>
    </button>
  </div>

  <div
    id="chat-log"
    role="log"
    aria-label={`Conversation with ${agent.name}`}
    data-chat-log
    class="flex min-h-40 flex-1 flex-col gap-2.5 overflow-y-auto fit:min-h-0 in-data-expanded:mx-auto in-data-expanded:min-h-0 in-data-expanded:w-full in-data-expanded:max-w-3xl"
  >
    <p class="mt-auto max-w-[92%] rounded-[18px_18px_18px_6px] bg-ink-raise px-4 py-3">{agent.greeting}</p>
  </div>

  <ul
    aria-label="Suggested questions"
    class="flex flex-wrap gap-2 in-data-expanded:mx-auto in-data-expanded:w-full in-data-expanded:max-w-3xl"
  >
    {agent.suggestions.map((question) => (
      <li>
        <button
          type="button"
          data-chat-suggestion={question}
          class="min-h-11 cursor-pointer rounded-full border border-ink-line px-4 text-sm font-medium transition-colors hover:bg-ink-raise"
        >
          {question}
        </button>
      </li>
    ))}
  </ul>

  <form
    data-chat-form
    class="flex gap-2 rounded-full bg-ink-raise p-1.5 in-data-expanded:mx-auto in-data-expanded:w-full in-data-expanded:max-w-3xl"
  >
    <label for="ask-byte" class="sr-only">
      Ask {agent.name} a question about Piotr
    </label>
    <input
      id="ask-byte"
      name="question"
      type="text"
      autocomplete="off"
      maxlength="500"
      placeholder="Ask anything about Piotr…"
      class="min-h-11 min-w-0 flex-1 rounded-full bg-transparent px-4 text-ink-fg placeholder:text-ink-muted"
    />
    <button
      type="submit"
      aria-label="Send question"
      class="grid size-11 flex-none cursor-pointer place-items-center rounded-full bg-lime text-on-lime transition-opacity hover:opacity-85"
    >
      <svg
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M12 19V5M6 11l6-6 6 6"></path>
      </svg>
    </button>
  </form>
</section>

<script>
  import { insetClip } from '~/lib/clip';

  const chat = document.querySelector<HTMLElement>('[data-chat]');
  const bento = chat?.closest<HTMLElement>('[data-bento]');
  const toggle = chat?.querySelector<HTMLButtonElement>('[data-chat-toggle]');
  const log = chat?.querySelector<HTMLElement>('[data-chat-log]');
  const form = chat?.querySelector<HTMLFormElement>('[data-chat-form]');
  const input = form?.querySelector<HTMLInputElement>('input');

  if (chat && bento && toggle && log && form && input) {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const ease = 'cubic-bezier(0.2, 0.8, 0.2, 1)';
    const isExpanded = () => chat.hasAttribute('data-expanded');
    const otherTiles = () => [...bento.children].filter((tile): tile is HTMLElement => tile !== chat);
    const radius = () => parseFloat(getComputedStyle(chat).borderTopLeftRadius) || 0;
    let busy = false;
    let queued: boolean | undefined;

    const apply = (expanded: boolean) => {
      chat.toggleAttribute('data-expanded', expanded);
      bento.toggleAttribute('data-chat-expanded', expanded);
      toggle.setAttribute('aria-expanded', String(expanded));
      toggle.setAttribute('aria-label', expanded ? 'Close full chat' : 'Expand chat');
    };

    const fade = (elements: Element[], from: number, to: number, duration: number) =>
      Promise.all(
        elements.map(
          (el) =>
            el.animate([{ opacity: from }, { opacity: to }], { duration, easing: 'ease-out', fill: 'forwards' })
              .finished,
        ),
      );

    // Grow: fade the other tiles out, lay the chat out at full size, then reveal it from its old
    // footprint with an expanding rounded clip so text never stretches. Shrink runs the reverse.
    const setExpanded = async (expanded: boolean): Promise<void> => {
      if (busy) {
        // Remember the latest request (e.g. Esc pressed mid-animation) and run it afterwards.
        queued = expanded;
        return;
      }
      if (isExpanded() === expanded) return;
      if (reduceMotion.matches || typeof chat.animate !== 'function') {
        apply(expanded);
        return;
      }
      busy = true;
      try {
        if (expanded) {
          const small = chat.getBoundingClientRect();
          await fade(otherTiles(), 1, 0, 140);
          apply(true);
          for (const tile of otherTiles()) for (const a of tile.getAnimations()) a.cancel();
          const big = chat.getBoundingClientRect();
          const content = [...chat.children];
          void fade(content, 0, 1, 260).then(() =>
            content.forEach((el) => el.getAnimations().forEach((a) => a.cancel())),
          );
          await chat.animate(
            [{ clipPath: insetClip(small, big, radius()) }, { clipPath: insetClip(big, big, radius()) }],
            {
              duration: 380,
              easing: ease,
            },
          ).finished;
          if (chat.getBoundingClientRect().top < 0) chat.scrollIntoView({ block: 'start' });
        } else {
          const big = chat.getBoundingClientRect();
          apply(false);
          const small = chat.getBoundingClientRect();
          apply(true);
          await chat.animate(
            [{ clipPath: insetClip(big, big, radius()) }, { clipPath: insetClip(small, big, radius()) }],
            {
              duration: 320,
              easing: ease,
              fill: 'forwards',
            },
          ).finished;
          apply(false);
          for (const a of chat.getAnimations()) a.cancel();
          void fade([...chat.children, ...otherTiles()], 0, 1, 200).then(() =>
            [...chat.children, ...otherTiles()].forEach((el) => el.getAnimations().forEach((a) => a.cancel())),
          );
        }
      } finally {
        busy = false;
      }
      if (queued !== undefined) {
        const next = queued;
        queued = undefined;
        await setExpanded(next);
      }
    };

    const addMessage = (text: string, from: 'user' | 'byte') => {
      const bubble = document.createElement('p');
      bubble.textContent = text;
      bubble.className =
        from === 'user'
          ? 'max-w-[85%] self-end rounded-[18px_18px_6px_18px] bg-lime px-4 py-2.5 font-medium text-on-lime'
          : 'max-w-[92%] rounded-[18px_18px_18px_6px] bg-ink-raise px-4 py-3';
      log.append(bubble);
      log.scrollTop = log.scrollHeight;
    };

    const ask = (question: string) => {
      const text = question.trim();
      if (!text) return;
      void setExpanded(true);
      addMessage(text, 'user');
      window.setTimeout(() => addMessage(chat.dataset['reply'] ?? '', 'byte'), 500);
    };

    // Pointer clicks and typing expand the chat; keyboard focus alone does not (WCAG 3.2.1 On Focus).
    input.addEventListener('pointerdown', () => void setExpanded(true));
    input.addEventListener('input', () => void setExpanded(true));

    toggle.addEventListener('click', () => {
      const expand = !isExpanded();
      void setExpanded(expand);
      if (expand) input.focus();
    });

    for (const suggestion of chat.querySelectorAll<HTMLButtonElement>('[data-chat-suggestion]')) {
      suggestion.addEventListener('click', () => ask(suggestion.dataset['chatSuggestion'] ?? ''));
    }

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      ask(input.value);
      input.value = '';
      input.focus();
    });

    chat.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && isExpanded()) {
        event.preventDefault();
        void setExpanded(false);
      }
    });
  }
</script>
