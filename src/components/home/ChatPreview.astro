---
/**
 * Static preview of the "Ask Byte" chat. Phase 4 replaces this with the real streaming
 * agent (React island + /api/chat); until then the controls are visibly disabled.
 */
import { agent } from '~/data/profile';
---

<section
  aria-labelledby="chat-title"
  class="flex flex-col gap-3.5 fit:gap-3 rounded-tile border border-ink-border bg-ink p-6 text-ink-fg sm:col-span-2 lg:row-span-2 fit:p-5 fit-short:p-4"
>
  <div class="flex items-center gap-3">
    <span
      aria-hidden="true"
      class="grid size-11 place-items-center rounded-2xl bg-lime font-display text-xl font-extrabold text-on-lime"
    >
      {agent.name.charAt(0)}
    </span>
    <div class="min-w-0 flex-1">
      <h2 id="chat-title" class="font-display text-[22px] font-bold tracking-tight">
        Ask {agent.name}
      </h2>
      <p class="text-sm text-ink-muted">{agent.tagline}</p>
    </div>
    <span class="rounded-full border border-ink-line px-3 py-1 text-xs font-bold text-ink-muted">Coming soon</span>
  </div>

  <div class="flex min-h-40 flex-1 flex-col justify-end fit:min-h-0">
    <p class="max-w-[92%] rounded-[18px_18px_18px_6px] bg-ink-raise px-4 py-3">{agent.greeting}</p>
  </div>

  <div>
    <p class="mb-2 text-sm text-ink-muted fit:sr-only">You'll be able to ask things like:</p>
    <ul class="flex flex-wrap gap-2">
      {agent.suggestions.map((question) => (
        <li class="rounded-full border border-dashed border-ink-line px-4 py-2.5 text-sm font-medium">{question}</li>
      ))}
    </ul>
  </div>

  <form class="flex gap-2 rounded-full bg-ink-raise p-1.5" aria-describedby="chat-status">
    <label for="ask-byte" class="sr-only">
      Ask {agent.name} a question about Piotr
    </label>
    <input
      id="ask-byte"
      type="text"
      disabled
      placeholder={`${agent.name} is still in training…`}
      class="min-h-11 min-w-0 flex-1 rounded-full bg-transparent px-4 text-ink-fg placeholder:text-ink-muted disabled:cursor-not-allowed"
    />
    <button
      type="submit"
      disabled
      aria-label="Send question"
      class="grid size-11 flex-none place-items-center rounded-full bg-lime text-on-lime disabled:cursor-not-allowed disabled:opacity-60"
    >
      <svg
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M12 19V5M6 11l6-6 6 6"></path>
      </svg>
    </button>
  </form>
  <p id="chat-status" class="sr-only">
    The chat is not available yet.
  </p>
</section>
