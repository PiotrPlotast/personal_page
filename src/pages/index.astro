---
import BaseLayout from '~/layouts/BaseLayout.astro';
import ChatPreview from '~/components/home/ChatPreview.astro';
import { featuredProject, profile, projects, skills } from '~/data/profile';

const tile = 'rounded-tile border border-line bg-tile p-6';
const eyebrow = 'text-sm font-bold tracking-[0.06em] text-muted uppercase';
const pillPrimary =
  'inline-flex min-h-12 items-center rounded-full px-5.5 font-bold no-underline transition-opacity hover:opacity-85';
---

<BaseLayout>
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <!-- Hero -->
    <section
      aria-labelledby="hero-title"
      class:list={[tile, 'flex flex-col justify-between gap-8 p-[clamp(24px,3.5vw,40px)] sm:col-span-2 lg:row-span-2']}
    >
      <div>
        <div class="flex flex-wrap items-center gap-3.5">
          <!-- TODO(content): replace with a photo via astro:assets <Image>. -->
          <div
            aria-hidden="true"
            class="grid size-20 place-items-center rounded-3xl border border-dashed border-line-strong bg-bg font-display text-2xl font-extrabold"
          >
            PP
          </div>
          <p class="inline-flex items-center gap-2 rounded-full bg-lime px-3.5 py-1.5 text-sm font-bold text-on-lime">
            <span aria-hidden="true" class="size-2 rounded-full bg-on-lime"></span>
            Open to internships
          </p>
        </div>
        <h1
          id="hero-title"
          class="mt-6.5 font-display text-[clamp(42px,5vw,66px)] leading-[0.98] font-extrabold tracking-[-0.045em]"
        >
          Hi, I'm {profile.firstName}.
        </h1>
        <p class="mt-2 text-[15px] text-muted">a.k.a. {profile.nickname}</p>
        <p class="mt-4.5 max-w-[32ch] text-[clamp(18px,1.8vw,21px)] leading-normal">{profile.tagline}</p>
      </div>
      <div class="flex flex-wrap gap-2.5">
        <a href="/projects" class:list={[pillPrimary, 'bg-fg text-bg']}>
          See my work
        </a>
        <a href="/about" class:list={[pillPrimary, 'border border-line-strong']}>
          More about me
        </a>
      </div>
    </section>

    <ChatPreview />

    <!-- About -->
    <section aria-labelledby="about-title" class:list={[tile, 'flex flex-col gap-2.5 sm:col-span-2']}>
      <h2 id="about-title" class="font-display text-[26px] font-extrabold tracking-tight">
        About me
      </h2>
      <p class="text-muted">{profile.about}</p>
      <p class="mt-1">
        <a href="/about" class="font-bold text-accent no-underline hover:underline">
          More about me →
        </a>
      </p>
    </section>

    <!-- Status -->
    <section
      aria-labelledby="status-title"
      class="flex min-h-50 flex-col justify-between gap-5 rounded-tile bg-lime p-6 text-on-lime"
    >
      <h2 id="status-title" class="text-sm font-bold tracking-[0.06em] uppercase">
        Status
      </h2>
      <p class="font-display text-[26px] leading-[1.1] font-bold tracking-tight">{profile.availability}</p>
    </section>

    <!-- Location -->
    <section aria-labelledby="where-title" class:list={[tile, 'flex min-h-50 flex-col justify-between gap-5']}>
      <h2 id="where-title" class={eyebrow}>
        Based in
      </h2>
      <div>
        <p class="font-display text-3xl leading-tight font-bold tracking-tight">{profile.location}</p>
        <p class="mt-1 text-muted">{[profile.school, profile.timezone].filter(Boolean).join(' · ')}</p>
      </div>
    </section>

    <!-- Featured project -->
    <section aria-labelledby="featured-title" class:list={[tile, 'flex flex-col gap-4 sm:col-span-2 lg:row-span-2']}>
      <div class="flex items-baseline justify-between gap-3">
        <p class={eyebrow}>Featured project</p>
        <a href="/projects" class="font-bold text-accent no-underline hover:underline">
          All projects →
        </a>
      </div>
      <!-- TODO(content): replace with app screenshots via astro:assets <Image>. -->
      <div
        aria-hidden="true"
        class="grid min-h-55 flex-1 place-items-center rounded-[18px] border border-dashed border-line-strong bg-bg p-6 text-center font-display text-2xl font-bold text-muted"
      >
        {featuredProject.name}
      </div>
      <div>
        <h2 id="featured-title" class="font-display text-[28px] font-bold tracking-tight">
          <a href={featuredProject.repo} class="no-underline hover:underline">
            {featuredProject.name}
          </a>
        </h2>
        <p class="mt-1.5 text-muted">{featuredProject.description}</p>
        <ul aria-label="Tech stack" class="mt-3 flex flex-wrap gap-1.5">
          {featuredProject.stack.map((tech) => (
            <li class="rounded-full bg-bg px-3 py-1 text-[13px] font-medium">{tech}</li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Technologies -->
    <section aria-labelledby="tech-title" class:list={[tile, 'flex flex-col gap-3.5 sm:col-span-2']}>
      <h2 id="tech-title" class="font-display text-[26px] font-extrabold tracking-tight">
        Technologies
      </h2>
      <ul class="flex flex-wrap gap-2">
        {skills.map((skill) => (
          <li class="rounded-full bg-bg px-3.5 py-2 text-[15px] font-medium">{skill}</li>
        ))}
      </ul>
    </section>

    <!-- Writing -->
    <section aria-labelledby="blog-title" class:list={[tile, 'flex flex-col gap-2 sm:col-span-2']}>
      <div class="flex items-baseline justify-between gap-3">
        <h2 id="blog-title" class="font-display text-[26px] font-extrabold tracking-tight">
          Writing
        </h2>
        <a href="/blog" class="font-bold text-accent no-underline hover:underline">
          Blog →
        </a>
      </div>
      <p class="text-muted">
        First posts are on the way: notes on what I'm building and learning, starting with how this site and its AI
        agent were made.
      </p>
    </section>

    <!-- Smaller projects -->
    {projects.map((project) => (
      <section aria-label={`Project: ${project.name}`} class:list={[tile, 'flex min-h-50 flex-col gap-2']}>
        <p class="text-[13px] font-bold text-accent">{project.kind}</p>
        <h2 class="font-display text-[22px] font-bold tracking-tight">
          <a href={project.repo} class="no-underline hover:underline">
            {project.name}
          </a>
        </h2>
        <p class="text-[15px] text-muted">{project.description}</p>
        <p class="mt-auto text-[13px] text-muted">{project.stack.join(' · ')}</p>
      </section>
    ))}

    <!-- Contact -->
    <section
      aria-labelledby="contact-title"
      class="flex flex-col justify-between gap-4.5 rounded-tile border border-ink-border bg-ink p-6 text-ink-fg sm:col-span-2"
    >
      <div>
        <h2 id="contact-title" class="font-display text-3xl leading-tight font-extrabold tracking-tight">
          Let's work together.
        </h2>
        <p class="mt-1.5 text-ink-muted">Send a message and I'll get back to you within a day or two.</p>
      </div>
      <ul class="flex flex-wrap gap-2">
        <li>
          <a href="/contact" class:list={[pillPrimary, 'bg-lime text-on-lime']}>
            Write to me
          </a>
        </li>
        {profile.socials.map((link) => (
          <li>
            <a href={link.href} class:list={[pillPrimary, 'border border-ink-line px-4.5']}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>
