# Copy to .env for local development. Every value is optional; see README → "Byte, the AI agent".

# OpenRouter API key (openrouter.ai/keys). Without it Byte reports that it's offline.
OPENROUTER_API_KEY=

# Cloudflare Turnstile. Without these the bot check is skipped.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Upstash Redis (rate limits, budget, GitHub cache). Without it an in-memory store is used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional read-only GitHub token for Byte's GitHub lookups.
GITHUB_TOKEN=
