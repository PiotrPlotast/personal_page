# Copy to .env for local development. Every value is optional; see README → "Byte, the AI agent" and "Contact form".

# OpenRouter API key (openrouter.ai/keys). Without it Byte reports that it's offline.
OPENROUTER_API_KEY=

# Cloudflare Turnstile (Byte and the contact form). Without these the bot check is skipped.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Upstash Redis (rate limits, budget, GitHub cache). Without it an in-memory store is used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional read-only GitHub token for Byte's GitHub lookups.
GITHUB_TOKEN=

# Resend, for the contact form. Without the key and recipient the form reports that it's unavailable.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Optional sender; the default onboarding@resend.dev only delivers to your Resend account's email.
CONTACT_FROM_EMAIL=
