{
  "ci": {
    "collect": {
      "staticDistDir": "./.vercel/output/static",
      "url": [
        "http://localhost/",
        "http://localhost/pl/",
        "http://localhost/projects/",
        "http://localhost/projects/accountability-buddies/",
        "http://localhost/blog/",
        "http://localhost/blog/how-i-built-this-site/",
        "http://localhost/about/",
        "http://localhost/contact/"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:performance": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.95
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./.lighthouseci/reports"
    }
  }
}
